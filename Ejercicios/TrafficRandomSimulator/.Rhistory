# Instalar librerías del simulador
install.packages(c(
"shiny",
"DBI",
"RPostgres",
"dplyr",
"ggplot2",
"readr",
"DT"
))
# Verificar las librerías
librerias <- c(
"shiny",
"DBI",
"RPostgres",
"dplyr",
"ggplot2",
"readr",
"DT"
)
resultado <- sapply(
librerias,
requireNamespace,
quietly = TRUE
)
print(resultado)
if (all(resultado)) {
print("LIBRERIAS INSTALADAS CORRECTAMENTE")
} else {
print("FALTAN LIBRERIAS POR INSTALAR")
}
# Crear carpetas del proyecto
carpetas <- c(
"database",
"models",
"services",
"dataset",
"views"
)
for (carpeta in carpetas) {
dir.create(
carpeta,
showWarnings = FALSE,
recursive = TRUE
)
}
print("Carpetas creadas correctamente")
# Crear archivos del proyecto
archivos <- c(
"database/connection.R",
"database/init_db.R",
"models/vehiculo.R",
"models/semaforo.R",
"services/dataset_service.R",
"services/simulation_service.R",
"services/statistics_service.R",
"views/dashboard.R",
"app.R",
"config.R",
".gitignore"
)
for (archivo in archivos) {
if (!file.exists(archivo)) {
file.create(archivo)
}
}
print("Archivos creados correctamente")
list.files()
file.edit(".Renviron")
source("database/connection.R")
test_connection()
readRenviron(".Renviron")
source("database/connection.R")
test_connection()
source("database/init_db.R")
crear_tablas()
# Cargar el modelo
source("models/vehiculo.R")
# Generar tipo de vehiculo aleatorio
tipo <- generar_tipo_vehiculo()
# Generar velocidad
velocidad <- generar_velocidad(tipo)
# Crear vehiculo de prueba
vehiculo1 <- crear_vehiculo(
numero_vehiculo = 1,
tipo_vehiculo = tipo,
velocidad_kmh = velocidad,
intervalo_llegada_seg = 3.5,
tiempo_llegada_seg = 3.5,
tiempo_cruce_seg = 4.2
)
# Mostrar resultado
mostrar_vehiculo(vehiculo1)
# Cargar nuestro modelo
source("models/semaforo.R")
# Crear semaforo
semaforo1 <- crear_semaforo(
nombre = "Semaforo principal",
verde_segundos = 40,
amarillo_segundos = 5,
rojo_segundos = 35
)
# Cargar nuestro modelo
source("models/semaforo.R")
# Crear semaforo
semaforo1 <- crear_semaforo(
nombre = "Semaforo principal",
verde_segundos = 40,
amarillo_segundos = 5,
rojo_segundos = 35
)
# Mostrar configuracion
mostrar_semaforo(semaforo1)
# Comprobar estados del semaforo
estado_semaforo(10, semaforo1)
estado_semaforo(42, semaforo1)
estado_semaforo(60, semaforo1)
# Calcular espera de un vehiculo
espera <- calcular_espera_semaforo(
tiempo_llegada = 50,
tiempo_cruce = 4,
semaforo = semaforo1
)
print(paste(
"Tiempo de espera:",
espera,
"segundos"
))
# Cargar las funciones del dataset
source("services/dataset_service.R")
# Generar 500 vehiculos
datos <- generar_dataset_trafico(
cantidad = 500,
semilla = 123
)
# Mostrar primeros registros
head(datos)
# Mostrar resumen
resumen_dataset(datos)
source("services/simulation_service.R")
semaforo1 <- crear_semaforo(
verde_segundos = 40,
amarillo_segundos = 5,
rojo_segundos = 35
)
resultado <- simular_trafico(
metodo = "Transformada inversa",
cantidad = 100,
semaforo = semaforo1,
semilla = 123
)
head(resultado$vehiculos)
head(resultado$resultados)
resultado$promedio_espera
resultado$tiempo_total
source("services/statistics_service.R")
analisis <- analizar_simulacion(resultado)
print(analisis$resumen)
print(analisis$pruebas)
source("database/simulation_repository.R")
# Guardar la simulacion que generamos
id_guardado <- guardar_simulacion(
resultado,
analisis
)
# Consultar historial
head(consultar_historial())
# Consultar vehiculos guardados
head(consultar_detalles(id_guardado))
# Consultar pruebas estadisticas
consultar_pruebas(id_guardado)
shiny::runApp(".")
View(mostrar_vehiculo)
